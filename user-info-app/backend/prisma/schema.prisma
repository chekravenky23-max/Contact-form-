generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserSubmission {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String
  address   String
  pincode   String
  createdAt DateTime @default(now())
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}
